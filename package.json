{
  "name": "@liquidau/solvers",
  "version": "0.6.2",
  "license": "MIT",
  "description": "Exact, scikit-learn-verified solvers in TypeScript: weighted L2 logistic regression (Newton/IRLS), Platt scaling, weighted isotonic regression, plus calibration and evaluation metrics (Wilson CI, prevalence reweighting, weighted ECE, Cohen's kappa) and MAPIE/crepes-verified conformal thresholds.",
  "keywords": [
    "logistic-regression",
    "calibration",
    "platt-scaling",
    "isotonic-regression",
    "scikit-learn",
    "conformal-prediction",
    "machine-learning"
  ],
  "homepage": "https://github.com/swim/solvers#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swim/solvers.git"
  },
  "bugs": {
    "url": "https://github.com/swim/solvers/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "@liquidau/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --import tsx --conditions=@liquidau/source --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
